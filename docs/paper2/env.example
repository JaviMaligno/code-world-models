# Credentials template for docs/paper2 (review point #19).
# Copy to <repo-root>/.env and fill in. NEVER commit the filled file:
# .gitignore already excludes .env. No value here is a real secret.
#
# Every variable below is read by name from os.environ by the
# scripts listed in results/repro_manifest.json -> env_config.
# The CPU-only reproduction (Tables 2-9, all figures, the whole
# audit) needs NONE of them; they are required only for the LLM
# synthesis arms.

# deployment name behind the paper's "large" (gpt-5.4)
AZURE_DEPLOYMENT_LARGE=gpt-5.4

# deployment name behind the paper's "mini" (gpt-5.4-mini)
AZURE_DEPLOYMENT_MINI=gpt-5.4-mini

# deployment name behind "nano" (paper 1 arms only)
AZURE_DEPLOYMENT_NANO=gpt-5.4-nano

# Azure OpenAI API key (secret)
AZURE_OPENAI_API_KEY=

# Azure OpenAI API version; paper 2 used 2025-04-01-preview
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Azure OpenAI resource endpoint URL
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/

# Hugging Face token for the Inference Providers router (Qwen cross-family arm)
HF_TOKEN=
